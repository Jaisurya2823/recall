# --- CockroachDB Cloud ---
# Get this connection string from your CockroachDB Cloud cluster's "Connect" panel.
# Example: postgresql://user:password@host:26257/defaultdb?sslmode=verify-full
COCKROACHDB_URL=

# --- AWS Bedrock ---
# Standard AWS credentials. Make sure the IAM user/role has bedrock:InvokeModel permission,
# and that you have requested model access for the models below in the Bedrock console.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Bedrock model IDs (defaults shown — change if you use different models)
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Optional: S3 for attachments ---
S3_BUCKET_NAME=
